<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VCR"
        tools:targetApi="31">
        <activity
            android:name=".UI.MyReviews"
            android:exported="false" />
        <activity
            android:name=".UI.ProfileSettings"
            android:exported="false" />
        <activity
            android:name=".UI.AccountSettings"
            android:exported="false" />
        <activity
            android:name=".UI.ReviewList"
            android:exported="false" />
        <activity
            android:name=".UI.Recommendation"
            android:exported="false" />
        <activity
            android:name=".UI.MenuDetail"
            android:exported="false" />
        <activity
            android:name=".SplashScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".UI.SignUp"
            android:exported="false" />
        <activity
            android:name=".UI.LogIn"
            android:exported="false" />
        <activity
            android:name=".UI.MainPage"
            android:exported="false" />
        <activity
            android:name=".UI.CanteenDetail"
            android:exported="false" />
        <activity
            android:name=".UI.FullscreenImageActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
    </application>

</manifest>