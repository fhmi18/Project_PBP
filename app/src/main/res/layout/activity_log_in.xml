<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white"
    tools:context=".UI.LogIn">

    <!-- Logo Aplikasi -->
    <ImageView
        android:id="@+id/appLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:src="@drawable/app_logo"
        android:contentDescription="App Logo"/>

    <!-- Log In Text -->
    <TextView
        android:id="@+id/loginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:text="Log In"
        android:textColor="@color/black"
        android:textSize="32sp"
        android:textStyle="bold"/>

    <!-- EditText Email -->
    <EditText
        android:id="@+id/email"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/custom_editext"
        android:drawableLeft="@drawable/baseline_email_24"
        android:drawablePadding="8dp"
        android:hint="Email"
        android:padding="12dp"
        android:textColor="@color/black"
        android:textSize="18sp"/>

    <!-- EditText Password -->
    <EditText
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/custom_editext"
        android:drawableLeft="@drawable/baseline_lock_24"
        android:drawablePadding="8dp"
        android:hint="Password"
        android:inputType="textPassword"
        android:padding="12dp"
        android:textColor="@color/black"
        android:textSize="18sp"/>

    <!-- Forgot Password -->
    <TextView
        android:id="@+id/forgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingTop="8dp"
        android:text="Lupa Password?"
        android:textColor="#E94B64"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- Tombol LogIn -->
    <Button
        android:id="@+id/loginButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/Primary"
        android:text="Login"
        android:textSize="18sp"
        app:cornerRadius="20dp"/>

    <!-- Atau log in dengan -->
    <TextView
        android:id="@+id/logText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="Atau log in dengan"
        android:textColor="@color/black"
        android:textSize="14sp"/>

    <!-- Tombol Sosial Media dalam Horizontal LinearLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/facebookSignUp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="@color/facebookBlue"
            android:text="Facebook"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:drawableLeft="@drawable/ic_facebook"
            android:drawablePadding="10dp"
            app:cornerRadius="20dp"/>

        <Space
            android:layout_width="16dp"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/googleSignUp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="@color/googleRed"
            android:text="Google"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:drawableLeft="@drawable/ic_google"
            android:drawablePadding="10dp"
            app:cornerRadius="20dp"/>
    </LinearLayout>

    <!-- Sign Up Redirect -->
    <TextView
        android:id="@+id/signupRedirectText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:text="Belum memiliki akun? Sign Up sekarang"
        android:textColor="@color/black"
        android:textSize="14sp"/>
</LinearLayout>
