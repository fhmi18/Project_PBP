<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".UI.Recommendation">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/Primary"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Recommendation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View android:layout_width="24dp" android:layout_height="24dp" /> <!-- Spacer -->
    </LinearLayout>

    <!-- Title (ID ditambahkan) -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_marginStart="16dp"
        android:text="Food"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Subtitle (ID ditambahkan) -->
    <TextView
        android:id="@+id/subtitleTextView"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:text="Catch delicious eats near you"
        android:textColor="#777"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Filter buttons -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Button style="@style/CustomOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommended"
                app:strokeColor="@color/Primary"
                app:strokeWidth="2dp"
                android:layout_marginEnd="8dp"/>

            <Button style="@style/CustomOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discount promo"
                app:strokeColor="@color/Primary"
                app:strokeWidth="2dp"
                android:layout_marginEnd="8dp"/>

            <Button style="@style/CustomOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Free Promo"
                app:strokeColor="@color/Primary"
                app:strokeWidth="2dp"
                android:layout_marginEnd="8dp"/>

            <Button style="@style/CustomOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast"
                app:strokeColor="@color/Primary"
                app:strokeWidth="2dp"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- List of items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="15dp"
        app:fastScrollEnabled="true"
        app:fastScrollHorizontalThumbDrawable="@drawable/thumb_drawable"
        app:fastScrollHorizontalTrackDrawable="@drawable/line_drawable"
        app:fastScrollVerticalThumbDrawable="@drawable/thumb_drawable"
        app:fastScrollVerticalTrackDrawable="@drawable/line_drawable"
        android:contentDescription="List of recommendations" />
</LinearLayout>
